[Unit]
Description=Scrapper Next.js development portal
After=network-online.target scrapper-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/repos/scrapper/src/web
Environment=BACKEND_URL=http://127.0.0.1:8788
ExecStart=/usr/local/bin/node /repos/scrapper/src/web/node_modules/next/dist/bin/next dev --hostname 100.111.171.20 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
