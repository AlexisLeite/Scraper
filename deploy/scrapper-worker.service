[Unit]
Description=Scrapper persistent extraction workers
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/repos/scrapper
ExecStart=/repos/scrapper/.venv/bin/python -m src.persistent.worker
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
OOMPolicy=stop
CPUAccounting=true
MemoryAccounting=true
CPUQuota=100%
MemoryMax=infinity
MemoryHigh=infinity
MemorySwapMax=infinity
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
